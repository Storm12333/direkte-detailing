{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.direktedetailing.dk" }],
      "destination": "https://direktedetailing.dk/:path*",
      "permanent": true
    },
    { "source": "/priser.html", "destination": "/services.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(Billeder|video)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
